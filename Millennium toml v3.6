[plugin]
id = "com.local.steam_inventory_mock"
name = "Steam Inventory Mock"
version = "3.6.0"
author = "Local"
description = "Local-only visual CS2 inventory mock for Steam Community inventory pages."

[assets]
resources=["resources/**/*"]

[backend]
entry = "backend/main.lua"
sources = ["backend/**/*.lua"]

[frontend]
entry = "frontend/index.tsx"

[webkit]
entry = "webview/preload.ts"

[compiler]
output_path = "auto"

[dev]
auto_restart = true
reload_steamui_when = "both"

[inspect]
depth = 4
colors = true
show_hidden = true

[logger]
padding = 0
backend_prefix = "SIM3.6"
frontend_prefix = "SIM3.6"
webview_prefix = "SIM3.6"

[patches]
debug = true
