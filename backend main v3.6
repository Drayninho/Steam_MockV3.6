local logger = require("logger")
local millennium = require("millennium")

require("rpc_functions")

local function on_load()
    logger:info("Steam Inventory Mock loaded with Millennium " .. millennium.version())
    millennium.ready()
end

local function on_unload()
    logger:info("Steam Inventory Mock unloaded")
end

return {
    on_load = on_load,
    on_unload = on_unload,
}
