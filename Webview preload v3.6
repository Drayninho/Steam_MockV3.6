type CatalogSkin = {
  market_hash_name:string; weapon:string; finish:string; rarity:string; rarityColor?:string;
  wears:string[]; floatMin:number; floatMax:number; image?:string; stattrak?:boolean; souvenir?:boolean;
};
type MockItem = {
  id:string; name:string; weapon:string; finish:string; wear:string; float:string; pattern:string;
  rarity:string; rarityColor?:string; stattrak:boolean; kills:number; souvenir:boolean;
  imageUrl:string; marketUrl:string; source?:string;
